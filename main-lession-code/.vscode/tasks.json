{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Bien dich file dang mo",
            "type": "shell",
            "command": "/usr/bin/g++",
            "args": [
                "-std=c++20",
                "-Wall",
                "-Wextra",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": { "cwd": "${fileDirname}" },
            "problemMatcher": ["$gcc"],
            "group": { "kind": "build", "isDefault": true },
            "presentation": { "reveal": "silent", "clear": true }
        },
        {
            "label": "Bien dich va chay",
            "type": "shell",
            "command": "/usr/bin/g++ -std=c++20 -Wall -Wextra -g '${file}' -o '${fileDirname}/${fileBasenameNoExtension}' && '${fileDirname}/${fileBasenameNoExtension}'",
            "options": { "cwd": "${fileDirname}" },
            "problemMatcher": ["$gcc"],
            "presentation": { "reveal": "always", "clear": true }
        }
    ]
}
